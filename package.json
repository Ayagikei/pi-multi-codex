{
  "name": "@ayagikei/pi-multi-codex",
  "version": "2.0.0",
  "description": "Automatically rotate multiple ChatGPT Codex OAuth accounts behind one Pi provider.",
  "keywords": [
    "pi-package",
    "pi",
    "codex",
    "oauth"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "LICENSE",
    "docs",
    "extensions",
    "example.png",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/*.ts test/*.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ayagikei/pi-multi-codex.git"
  },
  "bugs": {
    "url": "https://github.com/Ayagikei/pi-multi-codex/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "image": "https://raw.githubusercontent.com/Ayagikei/pi-multi-codex/main/example.png"
  },
  "dependencies": {
    "@henryqw/pi-config-store": "^1.1.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^7.0.2"
  }
}
